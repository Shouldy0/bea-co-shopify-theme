<section class="wrap section-space cart-page"><p class="eyebrow">ONE STEP CLOSER</p><h1>Your bag.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><div><a href="{{ item.url }}"><h3>{{ item.product.title | escape }}</h3></a><p>{{ item.final_price | money_with_currency }}</p>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<a href="{{ item.url_to_remove }}">Remove</a></div><div><label for="Quantity-{{ forloop.index }}">Quantity</label><input id="Quantity-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}"><p>{{ item.final_line_price | money_with_currency }}</p></div></div>{% endfor %}<div class="cart-summary"><h2>Total {{ cart.total_price | money_with_currency }}</h2><p>Taxes calculated at checkout where applicable. Digital delivery; no physical shipment.</p><div class="hero-actions"><button class="button secondary" name="update" type="submit">Update bag</button><button class="button" name="checkout" type="submit">Continue to checkout ↗</button></div></div></form>{% else %}<p>Your bag is waiting for a little clarity.</p><a class="button" href="{{ routes.root_url }}#the-kit">Explore the kit ↗</a>{% endif %}</section>{% schema %}{"name":"Bea cart","settings":[]}{% endschema %}