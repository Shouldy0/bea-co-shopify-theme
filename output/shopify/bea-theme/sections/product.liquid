<section class="wrap product-page"><div class="product-gallery"><img src="{{ 'guide-cover.png' | asset_url }}" width="530" height="750" alt="Cover of the Calm-Alone Guide"><a class="text-link" href="{{ 'guide-preview.pdf' | asset_url }}" target="_blank" rel="noopener">Preview the guide ↗</a></div><div><p class="eyebrow">BEA & CO. / DIGITAL RESOURCE</p><h1>{{ product.title | escape }}</h1><p class="lede">A little structure for the small steps around alone time.</p><div class="price">{{ product.selected_or_first_available_variant.price | money_with_currency }} <span>one-time purchase</span></div><div class="product-description">{{ product.description }}</div>{% form 'product',product %}{% if product.variants.size > 1 %}<label for="Variant-{{ section.id }}">Choose your kit</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<input type="hidden" name="quantity" value="1"><button class="button full" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add the kit to your bag ↗{% else %}Currently unavailable{% endif %}</button>{{ form.errors | default_errors }}{% endform %}<p class="micro">English · 3 PDFs · 22 pages · Digital delivery</p><p class="micro">An owner-created educational guide, not a personalised treatment plan.</p>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></section><section class="wrap section-space"><h2>Inside <em>your kit.</em></h2>{% render 'kit-includes' %}</section><section class="faq-section"><div class="wrap faq-grid"><h2>Before<br><em>you choose.</em></h2><div>{% render 'faq' %}</div></div></section><script type="application/ld+json">{{ product | structured_data }}</script>{% schema %}{"name":"Bea product","settings":[],"blocks":[{"type":"@app"}]}{% endschema %}