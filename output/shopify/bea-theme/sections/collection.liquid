<section class="wrap section-space"><h1>{{ collection.title | escape }}</h1>{{ collection.description }}{% paginate collection.products by 12 %}<div class="catalogue">{% for product in collection.products %}<a href="{{ product.url }}"><h2>{{ product.title | escape }}</h2><p>{{ product.price | money_with_currency }}</p><span class="text-link">Explore ↗</span></a>{% else %}<p>New resources are being prepared.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>{% schema %}{"name":"Bea collection","settings":[]}{% endschema %}