{{ 'journal.css' | asset_url | stylesheet_tag }}
<article class="bea-article">
  <header class="article-header">
    <a class="journal-read" href="{{ blog.url }}">← Back to the journal</a>
    <h1>{{ article.title | escape }}</h1>
    <div class="article-meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %B %Y' }}</time>{% if article.author != blank %}<span>By {{ article.author | escape }}</span>{% endif %}</div>
    {% if article.image %}<figure class="article-hero-image">{{ article.image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(max-width: 760px) 100vw, 760px' }}</figure>{% endif %}
  </header>
  <div class="article-body">{{ article.content }}</div>
  <footer class="article-footer">
    <a class="journal-read" href="{{ blog.url }}">More notes on alone time <span aria-hidden="true">↗</span></a>
    <p class="article-disclaimer">Bea & Co. creates educational resources for dog owners. Our articles and kit are not a diagnosis, veterinary advice or an individual treatment plan. If your dog is distressed or at risk of injury, contact your veterinarian.</p>
  </footer>
</article>
{% schema %}
{"name":"Bea article","settings":[],"presets":[{"name":"Bea article"}]}
{% endschema %}
