{%- comment -%}
  Bea & Co — Blog Template
  Design consistent with brand: warm, honest, practical
{%- endcomment -%}

<div class="page-header wrap">
  <p class="eyebrow">A LITTLE CLARITY</p>
  <h1>Notes on <em>alone time.</em></h1>
  <p class="lede">Thoughtful observations, practical guidance, and honest reflections for dog owners navigating separation anxiety.</p>
</div>

{%- paginate blog.articles by 12 -%}
  <section class="blog-section wrap section-space">
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <article class="blog-card">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="blog-card-image">
              <img src="{{ article.image | image_url: width: 800 }}" 
                   alt="{{ article.image.alt | escape }}" 
                   loading="lazy" 
                   width="400" 
                   height="260">
            </a>
          {%- endif -%}
          <div class="blog-card-content">
            <p class="blog-card-date">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            {%- if article.excerpt != blank -%}
              <p>{{ article.excerpt | strip_html | truncatewords: 25 }}</p>
            {%- else -%}
              <p>{{ article.content | strip_html | truncatewords: 25 }}</p>
            {%- endif -%}
            <a href="{{ article.url }}" class="text-link">Read more ↗</a>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="pagination wrap">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="text-link">← Previous</a>
        {%- endif -%}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="text-link">Next ↗</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </section>

  <aside class="blog-sidebar wrap section-space">
    <div class="sidebar-card">
      <p class="eyebrow">FREE RESOURCE</p>
      <h3>Is it separation anxiety?</h3>
      <p>Download our free symptoms checklist — a simple tool to help you notice patterns and prepare for conversations with your vet.</p>
      <a class="button" href="/products/beas-calm-alone-kit">Get the checklist ↗</a>
      <p class="micro">No spam. Just thoughtful care.</p>
    </div>
    <div class="sidebar-card">
      <p class="eyebrow">POPULAR TOPICS</p>
      <ul class="tag-list">
        {%- for tag in blog.tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </aside>
{%- endpaginate -%}

<style>
.blog-section {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 60px;
  align-items: start;
}

.blog-grid {
  display: grid;
  gap: 40px;
}

.blog-card {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 30px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}

.blog-card:last-child {
  border-bottom: none;
}

.blog-card-image {
  display: block;
  aspect-ratio: 3/2;
  overflow: hidden;
}

.blog-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.blog-card-image:hover img {
  transform: scale(1.03);
}

.blog-card-date {
  font-size: 0.85rem;
  color: #666;
  margin: 0 0 10px;
}

.blog-card-content h2 {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  line-height: 1.3;
  margin: 0 0 12px;
}

.blog-card-content h2 a {
  color: var(--color-text);
  text-decoration: none;
}

.blog-card-content h2 a:hover {
  color: var(--color-accent);
}

.blog-card-content p {
  color: #555;
  font-size: 0.95rem;
  line-height: 1.6;
}

.pagination {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-top: 40px;
  padding-top: 30px;
  border-top: 1px solid rgba(0,0,0,0.08);
}

.blog-sidebar {
  position: sticky;
  top: 40px;
}

.sidebar-card {
  background: #faf9f7;
  padding: 30px;
  margin-bottom: 30px;
}

.sidebar-card h3 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  margin: 0 0 12px;
}

.sidebar-card p {
  font-size: 0.9rem;
  color: #555;
  line-height: 1.6;
}

.sidebar-card .button {
  display: inline-block;
  margin-top: 15px;
}

.tag-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.tag-list li {
  margin-bottom: 8px;
}

.tag-list a {
  color: #555;
  text-decoration: none;
  font-size: 0.9rem;
}

.tag-list a:hover {
  color: var(--color-accent);
}

@media (max-width: 900px) {
  .blog-section {
    grid-template-columns: 1fr;
  }
  .blog-card {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  .blog-sidebar {
    position: static;
    margin-top: 40px;
  }
}
</style>

{% schema %}
{
  "name": "Blog",
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}
