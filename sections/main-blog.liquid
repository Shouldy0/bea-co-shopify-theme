{{ 'journal.css' | asset_url | stylesheet_tag }}
<section class="bea-journal container" aria-labelledby="JournalTitle-{{ section.id }}">
  <header class="journal-intro">
    <p class="journal-kicker">BEA & CO. / THE JOURNAL</p>
    <h1 id="JournalTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    <p class="journal-deck">{{ section.settings.intro | escape }}</p>
    <span class="journal-signature">Small steps. Thoughtful care.</span>
  </header>
  {% if blog.all_tags.size > 0 %}
    <nav class="journal-topics" aria-label="Filter articles by topic">
      <a href="{{ blog.url }}" {% unless current_tags %}aria-current="page"{% endunless %}>All notes</a>
      {% for tag in blog.all_tags %}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>{{ tag | escape }}</a>
      {% endfor %}
    </nav>
  {% endif %}
  {% paginate blog.articles by 9 %}
    <div class="journal-grid">
      {% for article in blog.articles %}
        <article class="journal-card{% if forloop.first %} journal-feature{% endif %}">
          <a class="journal-image" href="{{ article.url }}" aria-label="Read {{ article.title | escape }}">
            {% if article.image %}
              {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(max-width: 700px) 100vw, 50vw' }}
            {% else %}
              <img src="{{ 'bea.jpg' | asset_url }}" alt="Bea, the dog behind Bea & Co." width="1200" height="1600" loading="lazy">
            {% endif %}
          </a>
          <div class="journal-card-copy">
            <p class="journal-kicker">{% if forloop.first %}FEATURED NOTE{% else %}FROM THE JOURNAL{% endif %} <span aria-hidden="true">/</span> <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %b %Y' }}</time></p>
            <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
            <a class="journal-read" href="{{ article.url }}">Read the note <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      {% else %}
        <p class="journal-empty">No notes here yet. <a href="{{ blog.url }}">View all notes</a>.</p>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="journal-pagination" aria-label="Blog pagination">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
  {% assign journal_kit = all_products['beas-calm-alone-kit'] %}
  {% if journal_kit != blank %}
    <aside class="journal-kit" aria-labelledby="JournalKitTitle-{{ section.id }}">
      <div><p class="journal-kicker">FROM READING TO RECORDING</p><h2 id="JournalKitTitle-{{ section.id }}">A place for your<br><em>own observations.</em></h2></div>
      <div><p>Bring your notes together with Bea's Calm-Alone Kit: an educational guide and fillable workbook. Not a diagnosis or an individual treatment plan.</p><a class="btn btn-caramel" href="{{ journal_kit.url }}">Explore the kit <span aria-hidden="true">↗</span></a><p class="journal-small">English PDFs · {{ journal_kit.price | money_with_currency }} · One-time purchase</p></div>
    </aside>
  {% endif %}
</section>
{% schema %}
{"name":"Bea journal","settings":[{"type":"text","id":"heading","label":"Heading","default":"Notes on alone time."},{"type":"textarea","id":"intro","label":"Introduction","default":"For the questions that come with caring. Thoughtful reading on noticing your dog's needs, keeping useful notes and knowing when to ask for help."}],"presets":[{"name":"Bea journal"}]}
{% endschema %}
