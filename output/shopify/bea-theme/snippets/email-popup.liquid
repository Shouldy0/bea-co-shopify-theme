{%- comment -%}
  Bea & Co — Email Capture Popup
  Shows on homepage load after 5 seconds
  Trigger: exit-intention OR 5s delay
{%- endcomment -%}

{%- if template.name == 'index' -%}
<div id="email-popup" class="email-popup" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
  <div class="email-popup-overlay"></div>
  <div class="email-popup-content">
    <button class="email-popup-close" aria-label="Close popup">&times;</button>
    <p class="eyebrow">FREE RESOURCE</p>
    <h2>Is it separation anxiety?</h2>
    <p>Download our free symptoms checklist — a simple, printable tool to help you notice patterns and prepare for conversations with your vet.</p>
    <form id="email-capture-form" class="email-popup-form">
      <input type="email" name="email" placeholder="Your email address" required autocomplete="email">
      <button type="submit" class="button">Get the checklist ↗</button>
    </form>
    <p class="micro">No spam. Just thoughtful care. Unsubscribe anytime.</p>
    <p class="popup-success" style="display:none;">Thank you! Check your inbox for the checklist.</p>
  </div>
</div>

<style>
.email-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.email-popup-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
}
.email-popup-content {
  position: relative;
  background: #fff;
  padding: 50px 40px;
  max-width: 480px;
  width: 90%;
  text-align: center;
  border-radius: 4px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}
.email-popup-close {
  position: absolute;
  top: 15px;
  right: 20px;
  background: none;
  border: none;
  font-size: 28px;
  cursor: pointer;
  color: #999;
  line-height: 1;
}
.email-popup-close:hover {
  color: #333;
}
.email-popup-content h2 {
  font-family: var(--font-serif);
  font-size: 1.75rem;
  margin: 10px 0 15px;
}
.email-popup-content p {
  color: #555;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 20px;
}
.email-popup-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.email-popup-form input {
  padding: 14px 16px;
  border: 1px solid #ddd;
  border-radius: 3px;
  font-size: 1rem;
  width: 100%;
  box-sizing: border-box;
}
.email-popup-form .button {
  width: 100%;
}
.email-popup .micro {
  font-size: 0.8rem;
  color: #999;
  margin-top: 15px;
}
.popup-success {
  color: #4a7c59;
  font-weight: 500;
}
</style>

<script>
(function() {
  var popup = document.getElementById('email-popup');
  if (!popup) return;
  
  var shown = false;
  var delay = 5000; // 5 seconds
  
  function showPopup() {
    if (shown) return;
    shown = true;
    popup.style.display = 'flex';
    popup.setAttribute('aria-hidden', 'false');
  }
  
  function hidePopup() {
    popup.style.display = 'none';
    popup.setAttribute('aria-hidden', 'true');
  }
  
  // Show after delay
  setTimeout(showPopup, delay);
  
  // Close button
  popup.querySelector('.email-popup-close').addEventListener('click', hidePopup);
  
  // Click outside
  popup.querySelector('.email-popup-overlay').addEventListener('click', hidePopup);
  
  // Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hidePopup();
  });
  
  // Form submit
  var form = document.getElementById('email-capture-form');
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var email = form.querySelector('input[name="email"]').value;
    if (!email) return;
    
    // Send to Klaviyo/Omnisend via their API
    // Replace with your actual integration
    console.log('Email captured:', email);
    
    // Show success
    form.style.display = 'none';
    popup.querySelector('.popup-success').style.display = 'block';
    
    // Close after 3 seconds
    setTimeout(hidePopup, 3000);
  });
})();
</script>
{%- endif -%}
